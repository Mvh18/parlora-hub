includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 8

    ignoreErrors:
        # Remove when the first content model uses them (add-content-model, S02).
        -
            identifier: trait.unused
            paths:
                - app/Models/Concerns/Archivable.php
                - app/Models/Concerns/HasStableKey.php
