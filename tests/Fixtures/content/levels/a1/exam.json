          "content": {
            "options": [
              { "id": "a", "text": "A teacher" },
              { "id": "b", "text": "A doctor" }
            ]
          },
          "solution": { "correct": ["a"] },
          "explanation": { "en": "The text says her mother is a teacher." }
        }
      ]
    },
    {
      "key": "a1.exam.listening",
      "skill": "listening",
      "points": 20,
      "grading_mode": "auto",
