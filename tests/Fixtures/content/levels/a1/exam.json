          "content": { "text": "They {{g1}} at home." },
          "solution": { "answers": { "g1": ["are"] } }
        },
        {
          "key": "a1.exam.uoe.q03",
          "type": "reorder",
          "points": 2,
          "content": {
            "tokens": [
              { "id": "t2", "text": "is" },
              { "id": "t1", "text": "He" },
              { "id": "t3", "text": "tall" }
            ]
          },
          "solution": { "orders": [["t1", "t2", "t3"]] }
        }
      ]
    },
    {
      "key": "a1.exam.reading",
      "skill": "reading",
      "points": 20,
      "grading_mode": "auto",
      "questions": [
        {
          "key": "a1.exam.reading.q01",
          "type": "multiple_choice",
