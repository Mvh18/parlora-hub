# Normalise line endings in the repository to LF
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Language-aware diffs
*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.wav binary
*.mp3 binary

# Generated files: collapse in diffs
composer.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
contracts/parlora-tutor.openapi.json linguist-generated=true
CHANGELOG.md linguist-generated=true

# Not part of exported archives
/.github export-ignore
CHANGELOG.md export-ignore
