# Parlora Hub environment. Copy to .env (the Compose `app` service does it on
# its first start). Values here are safe local defaults: never commit real
# secrets. PHP runs in the Compose `app` service (ADR 0002), so service hosts
# and ports are the in-network ones (DB_HOST=postgres, ...); tools on the host
# use 127.0.0.1 with the FORWARD_* ports below.

APP_NAME="Parlora Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Host ports published by compose.yaml, always on 127.0.0.1. Change one if
# another program already uses it (Parlora Tutor uses 8700 and 5433). If you
# change APP_PORT, change the port in APP_URL too.
APP_PORT=8000
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# PostgreSQL (Compose `postgres` service).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hub
DB_USERNAME=hub
DB_PASSWORD=hub

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queues run on Valkey through the redis driver and are processed by Horizon.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Valkey (Compose `valkey` service), Redis-compatible.
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is captured by Mailpit (Compose `mailpit` service); read it at
# http://127.0.0.1:8025.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hub@parlora.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Parlora Hub settings (config/hub.php).
# Allow visitors to create an account. Turn off once the owner's account exists.
HUB_REGISTRATION_ENABLED=true

# Parlora Tutor integration (config/parlora_tutor.php). Leave disabled unless
# Parlora Tutor is running. PARLORA_TUTOR_API_KEY must equal Tutor's
# PARLORA_API_KEY and PARLORA_TUTOR_WEBHOOK_SECRET Tutor's
# PARLORA_WEBHOOK_SECRET.
PARLORA_TUTOR_ENABLED=false
PARLORA_TUTOR_URL=
PARLORA_TUTOR_API_KEY=
PARLORA_TUTOR_WEBHOOK_SECRET=
